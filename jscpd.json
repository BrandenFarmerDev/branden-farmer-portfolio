{
  "threshold": 3,
  "minLines": 8,
  "minTokens": 50,
  "formats": ["typescript", "tsx", "css"],
  "ignore": [
    "**/.wrangler/**",
    "**/dist/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/vite-env.d.ts"
  ],
  "reporters": ["console", "json"],
  "output": "reports/jscpd"
}
