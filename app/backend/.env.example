# Copy this file to `.dev.vars` for local development. Never commit `.dev.vars`.
# Production and preview secrets belong in their Cloudflare Worker secret stores.

# Local browser origin. The same default is declared in wrangler.toml.
ALLOWED_ORIGIN=http://localhost:5173

# Required provider secrets.
RESEND_API_KEY=replace_with_resend_api_key
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret_key

# Random 32+ byte value used to sign the anonymous Ask cookie and hash network addresses.
ASK_SIGNING_SECRET=replace_with_random_signing_secret

# Must match the secret configured on the Cal.com webhook.
CAL_WEBHOOK_SECRET=replace_with_cal_webhook_secret

# Required non-secret identifiers. Replace these local examples with values from the target deployment.
CAL_EVENT_TYPE_ID=replace_with_numeric_cal_event_type_id
ACCESS_TEAM_DOMAIN=replace_with_team.cloudflareaccess.com
ACCESS_AUD=replace_with_access_application_audience_tag
