{
  "name": "@portfolio/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --project tsconfig.json",
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
    "build:production": "wrangler deploy --dry-run --env production --outdir dist/production"
  },
  "dependencies": {
    "@portfolio/shared": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^26.6.5",
    "wrangler": "^4.151.0"
  }
}
