# Copy this file to `.env.local`. Every VITE_* value is public in the browser bundle.
# Preview uses https://api-preview.brandenfarmer.com; production uses https://api.brandenfarmer.com.
VITE_API_BASE_URL=http://localhost:8787

# Public Turnstile site key. Use Cloudflare's public test site key locally.
VITE_TURNSTILE_SITE_KEY=replace_with_public_turnstile_site_key
