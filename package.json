{
  "name": "branden-farmer-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "app/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names frontend,api --prefix-colors cyan,yellow \"npm run dev --workspace @portfolio/frontend\" \"npm run dev --workspace @portfolio/backend\"",
    "dev:frontend": "npm run dev --workspace @portfolio/frontend",
    "dev:backend": "npm run dev --workspace @portfolio/backend",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "duplication": "jscpd app packages --config jscpd.json",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "audit": "npm audit --audit-level=info",
    "audit:production": "npm audit --omit=dev --audit-level=info",
    "test:hooks": "node --test scripts/pre-push.test.mjs",
    "test:security-scan": "node --test scripts/security-scan.test.mjs",
    "secrets:source": "gitleaks dir --config .gitleaks.toml --redact --no-banner --no-color .",
    "secrets:build": "gitleaks dir --config .gitleaks.toml --redact --no-banner --no-color app/frontend/dist",
    "quality": "npm run lint && npm run test:hooks && npm run test:security-scan && npm run secrets:source && npm run test:coverage && npm run duplication && npm run typecheck && npm run build && npm run secrets:build && npm run audit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jscpd": "^5.4.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "undici": "^8.12.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "wrangler": {
      "miniflare": {
        "undici": "7.29.1"
      }
    }
  }
}
