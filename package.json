{
  "name": "branden-farmer-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "app/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names frontend,api --prefix-colors cyan,yellow \"npm run dev --workspace @portfolio/frontend\" \"npm run dev --workspace @portfolio/backend\"",
    "dev:frontend": "npm run dev --workspace @portfolio/frontend",
    "dev:backend": "npm run dev --workspace @portfolio/backend",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "duplication": "jscpd app packages --config jscpd.json",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "audit": "npm audit --audit-level=moderate",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "quality": "npm run lint && npm run test:coverage && npm run duplication && npm run typecheck && npm run build && npm run audit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^5.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^16.4.0",
    "jscpd": "^4.0.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "undici": "^7.29.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "wrangler": {
      "miniflare": {
        "undici": "7.29.1"
      }
    }
  }
}
